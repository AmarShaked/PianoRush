{
  "name": "Piano Rush",
  "short_name": "Piano Rush",
  "description": "Play real piano like a rhythm game.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#0b0b18",
